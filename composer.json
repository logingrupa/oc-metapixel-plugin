{
    "name": "logingrupa/metapixel-plugin",
    "type": "october-plugin",
    "description": "Meta Pixel + Conversions API for OctoberCMS",
    "keywords": [
        "october-cms",
        "october-plugin",
        "meta-pixel",
        "conversions-api",
        "capi",
        "facebook-pixel",
        "shopaholic",
        "tracking",
        "analytics"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Logingrupa",
            "email": "info@logingrupa.lv"
        }
    ],
    "require": {
        "composer/installers": "~1.0",
        "guzzlehttp/guzzle": "^7.8",
        "jeremykendall/php-domain-parser": "^6.4",
        "lovata/toolbox-plugin": "^2.2",
        "october/system": "^4.0",
        "php": "^8.3 || ^8.4"
    },
    "suggest": {
        "lovata/shopaholic-plugin": "Use ShopaholicAdapter to track Lovata Shopaholic Orders",
        "lovata/ordersshopaholic-plugin": "Use ShopaholicAdapter to track Lovata Orders Shopaholic Orders"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/pint": "^1.26",
        "lovata/buddies-plugin": "^1.10",
        "lovata/ordersshopaholic-plugin": "^1.33",
        "lovata/shopaholic-plugin": "^1.32",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-drift": "^4.0",
        "phpmd/phpmd": "^2.15",
        "phpunit/phpunit": "^12",
        "rector/rector": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spaze/phpstan-disallowed-calls": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Logingrupa\\Metapixel\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Logingrupa\\Metapixel\\Tests\\": "tests/"
        },
        "classmap": [
            "updates/"
        ]
    },
    "scripts": {
        "qa": ["@pint-test", "@analyse", "@phpmd", "@test-cov"],
        "pint-test": "@php ../../../vendor/bin/pint --test",
        "pint": "@php ../../../vendor/bin/pint",
        "analyse": "@php ../../../vendor/bin/phpstan analyse --memory-limit=1G",
        "phpmd": "@php ../../../vendor/bin/phpmd Plugin.php,classes,models,console,components,middleware,controllers text phpmd.xml",
        "test": "@php ../../../vendor/bin/pest",
        "test-cov": "@php -d pcov.enabled=1 ../../../vendor/bin/pest --coverage --min=90",
        "rector": "@php ../../../vendor/bin/rector process --dry-run",
        "deps": "composer-dependency-analyser"
    },
    "extra": {
        "october": {
            "plugin": "Logingrupa.Metapixel",
            "installer-name": "metapixel"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
